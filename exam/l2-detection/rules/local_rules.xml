<!--
  Экзамен L2 (Detection Engineering): Alert Fatigue + LOLBAS.
  СТАРТОВЫЕ правила аналитика (рабочий каталог exam/l2-detection/rules/,
  монтируется в manager как /var/ossec/etc/rules, см.
  exam/l2-detection/docker/compose.exam.yml).

  Нельзя менять:
    * группу windows,sysmon;
    * корневое правило 100001;
    * шумное правило 100250.

  TODO аналитика:
    1. Снизить Alert Fatigue: подавить ложные срабатывания 100250 для
       легитимной административной активности дочерними правилами
       level="0". Подавление обязано быть контекстным (проверенный
       родитель И/ИЛИ строго регламентная команда): глушение по одной
       подстроке аргументов (argument smuggling) или общий whitelist
       интерактивных процессов и планировщика создают слепые зоны —
       подозрительные запуски обязаны алертить и проверяются тестами.
    2. Реализовать детекты LOLBAS 100801 (certutil), 100802 (rundll32),
       100803 (mshta), 100804 (regsvr32). Скелеты заготовок — в конце файла.
       Требуемое покрытие шире «очевидных» форм: см. подсказки в блоках TODO.

  Проверка: wlogtest run /exam/test_dataset/test_suite.json (34 кейса)
-->
<group name="windows,sysmon,">

  <rule id="100001" level="0">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^1$</field>
    <description>Sysmon Event ID 1: Process Creation</description>
  </rule>

  <!-- Высокошумное правило: алертит на каждый запуск powershell/cmd/wmic. -->
  <rule id="100250" level="8">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell|cmd|wmic)\.exe$</field>
    <description>Administrative tool executed (High Alert Fatigue Rule)</description>
  </rule>

