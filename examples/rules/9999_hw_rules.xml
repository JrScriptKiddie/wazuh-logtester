<!--
  wazuh-logtest-offline student rules (Wazuh 4.14.7).

  Home-work rules for logs decoded by myapp_decoder:
    100100  base login event (level 5)
    100101  child of 100100 for failed logins (level 6)
    100102  frequency: 3 logins in 60s, same session (level 10, correlation)
-->
<group name="hw,local,">
  <rule id="100100" level="5">
    <decoded_as>myapp_decoder</decoded_as>
    <match>login user=</match>
    <description>myapp: user login event detected.</description>
  </rule>

  <rule id="100101" level="6">
    <if_sid>100100</if_sid>
    <match>status=failed</match>
    <description>myapp: user login failed.</description>
  </rule>

  <rule id="100102" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <description>myapp: 3 login events in 60 seconds.</description>
  </rule>
</group>
