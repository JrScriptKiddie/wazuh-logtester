<!--
  wazuh-logtest-offline student decoder (Wazuh 4.14.7).

  Parses myapp logs such as:
    Aug 27 10:00:00 myserver myapp[1234]: login user=alice status=failed
  into the alert fields "user" and "status".
-->
<decoder name="myapp_decoder">
  <program_name>myapp</program_name>
  <prematch>login user=</prematch>
  <regex>login user=(\S+) status=(\S+)</regex>
  <order>user, status</order>
</decoder>
